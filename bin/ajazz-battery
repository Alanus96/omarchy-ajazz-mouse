#!/usr/bin/env python3
"""Read the battery of an Ajazz / ATK-COMPX wireless mouse (e.g. AJ139 Pro).

Protocol (reverse-engineered by the SORA/COMPX community, used by the
Windows "mouse-battery-reminder" project): a vendor HID feature report,
report id 0x08, command 0x04.  The mouse answers with an input report whose
payload byte 5 is the charge percentage (0-100) and byte 6 the charging flag.

Modes:
    ajazz-battery                 # human readable, one line ("40 charging")
    ajazz-battery --status        # JSON for the Omarchy bar widget (cached)
    ajazz-battery --external-json # write ~/.cache/omarchy-accessories/external.json

Only the battery is readable; DPI / polling rate are not exposed by this
firmware (the COMPX GetEEPROM opcode is not answered).
"""
import argparse
import json
import os
import sys
import time

try:
    import hid
except ImportError:
    sys.stderr.write("python-hidapi not installed\n")
    sys.exit(1)

VID = 0x25A7
REPORT_ID = 0x08
CMD = 0x04
STATE_DIR = os.path.expanduser("~/.cache/ajazz-battery")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
EXTERNAL_JSON = os.path.expanduser("~/.cache/omarchy-accessories/external.json")
QUERY_INTERVAL = 45.0  # seconds; skip the USB round-trip while this fresh


# ── protocol ────────────────────────────────────────────────────────────────
def checksum(payload):
    s = REPORT_ID + sum(payload[:-1])
    return (85 - (s & 0xFF)) & 0xFF


def request_bytes():
    payload = bytearray(16)
    payload[0] = CMD
    payload[15] = checksum(payload)
    return bytes([REPORT_ID]) + bytes(payload)


def parse(resp):
    for start in (1, 0):
        if start + 6 >= len(resp) or resp[start] != CMD:
            continue
        pct = resp[start + 5]
        charge = resp[start + 6]
        if 1 <= pct <= 100:
            return pct, bool(charge)
    return None


# ── device discovery ────────────────────────────────────────────────────────
def candidates():
    """COMPX battery collections, best device first (wired mouse > dongle)."""
    found = []
    for d in hid.enumerate(VID):
        if d.get("usage_page", 0) < 0xFF00:
            continue
        prod = (d.get("product_string") or "").lower()
        wired = "mouse" in prod
        score = 0
        if wired:
            score += 100
        if "receiver" in prod or "dongle" in prod:
            score += 50
        if d.get("usage_page") == 0xFF04 and d.get("usage") == 0x0002:
            score += 1000
        found.append({"score": score, "d": d, "wired": wired})
    found.sort(key=lambda x: -x["score"])
    seen, out = set(), []
    for c in found:
        path = c["d"]["path"]
        if path in seen:
            continue
        seen.add(path)
        out.append(c)
    return out


def topology(cands):
    return ",".join(sorted(
        f"{c['d']['vendor_id']:04x}:{c['d']['product_id']:04x}:{c['d']['path']}"
        for c in cands
    ))


def query(cands):
    """Ask every candidate until one answers. Returns (pct, charging, cand)."""
    req = list(request_bytes())
    for c in cands:
        try:
            h = hid.device()
            h.open_path(c["d"]["path"])
        except Exception:
            continue
        try:
            h.set_nonblocking(0)
            sent = False
            for sender in (h.write, h.send_feature_report):
                try:
                    sender(req)
                    sent = True
                except Exception:
                    pass
            if not sent:
                continue
            deadline = time.time() + 0.8
            while time.time() < deadline:
                raw = h.read(64, 250)
                if raw:
                    parsed = parse(list(raw))
                    if parsed:
                        return parsed[0], parsed[1], c
        except Exception:
            pass
        finally:
            try:
                h.close()
            except Exception:
                pass
    return None


# ── state cache ─────────────────────────────────────────────────────────────
def load_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except Exception:
        return {}


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, "w") as fh:
        json.dump(state, fh)
        fh.flush()
        os.fsync(fh.fileno())


def read_status(force=False):
    cands = candidates()
    now = time.time()
    if not cands:
        save_state({"topology": "", "ts": now, "reading": None, "online": False})
        return {"present": False, "online": False}

    topo = topology(cands)
    state = load_state()
    if (not force and state.get("topology") == topo
            and now - float(state.get("ts", 0)) < QUERY_INTERVAL):
        reading = state.get("reading")
        online = bool(state.get("online"))
    else:
        result = query(cands)
        if result:
            pct, charging, cand = result
            reading = {"pct": pct, "charging": charging,
                       "transport": "wired" if cand["wired"] else "wireless"}
            online = True
        else:
            reading = state.get("reading")  # keep last known level
            online = False
        save_state({"topology": topo, "ts": now, "reading": reading, "online": online})

    out = {"present": True, "online": online}
    if reading:
        out.update(reading)
    return out


# ── output modes ────────────────────────────────────────────────────────────
def write_external_json(status, name):
    entry = {
        "id": "ajazz-aj139-pro",
        "name": name,
        "kind": "mouse",
        "pct": status.get("pct"),
        "charging": bool(status.get("charging")),
        "transport": status.get("transport") or "external",
        "ts": int(time.time()),
        "ttl": 300,
    }
    data = []
    try:
        with open(EXTERNAL_JSON) as fh:
            data = json.load(fh)
        if not isinstance(data, list):
            data = []
    except Exception:
        data = []
    data = [e for e in data if not (isinstance(e, dict) and e.get("id") == entry["id"])]
    data.append(entry)
    os.makedirs(os.path.dirname(EXTERNAL_JSON), exist_ok=True)
    with open(EXTERNAL_JSON, "w") as fh:
        json.dump(data, fh)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--status", action="store_true", help="JSON status for the bar widget")
    ap.add_argument("--external-json", action="store_true",
                    help="write the Omarchy peripheral-batteries external JSON")
    ap.add_argument("--force", action="store_true", help="ignore the cache, query now")
    ap.add_argument("--name", default="Ajazz AJ139 Pro")
    args = ap.parse_args()

    status = read_status(force=args.force or args.external_json)

    if args.status:
        print(json.dumps(status))
        return 0
    if args.external_json:
        write_external_json(status, args.name)
        return 0 if status.get("online") else 2

    if status.get("online"):
        print(f"{status['pct']} {'charging' if status.get('charging') else 'discharging'} "
              f"({status.get('transport')})")
        return 0
    print("no reading")
    return 2


if __name__ == "__main__":
    sys.exit(main())
